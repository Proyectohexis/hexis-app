{
  "name": "hexis-app",
  "version": "0.1.0",
  "description": "HEXIS — sistema móvil de transformación personal basada en identidad, disciplina y evidencia.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "expo-doctor --verbose",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase db reset && supabase test db",
    "test:privacy:e2e": "node scripts/privacy-e2e.cjs",
    "typecheck:client-core": "tsc -p tsconfig.client-core.json --pretty false",
    "typecheck:all": "tsc -p tsconfig.json --allowJs --checkJs --noEmit --pretty false",
    "typecheck:edge": "deno check --config supabase/functions/delete-account/deno.json --lock supabase/functions/delete-account/deno.lock --frozen supabase/functions/delete-account/index.ts",
    "lint:edge": "deno lint --config supabase/functions/delete-account/deno.json supabase/functions/delete-account/index.ts",
    "verify:deps": "node scripts/verify-dependencies.cjs",
    "verify:syntax": "node scripts/verify-syntax.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:mobile": "npm run typecheck:client-core && npm run verify:syntax && npm run verify:deps && npm test && npm run doctor && npm run export:android && npm run export:ios",
    "check": "npm run check:mobile"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@supabase/supabase-js": "2.106.2",
    "@types/react": "~19.1.10",
    "expo": "~54.0.35",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "3.0.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@babel/parser": "7.29.0",
    "expo-doctor": "1.20.0",
    "supabase": "^2.84.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
